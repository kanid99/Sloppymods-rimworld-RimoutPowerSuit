dist/
obj/
bin/
# Build output, except the one assembly RimWorld loads: RimSort clones this repo
# straight into the Mods folder, so a clone must carry the DLL (see CLAUDE.md).
Assemblies/*
!Assemblies/RimoutPowerSuit.dll
!Mods/Exosuit/Assemblies/
Mods/Exosuit/Assemblies/*
!Mods/Exosuit/Assemblies/RimoutPowerSuit.Exosuit.dll
*.user
__pycache__/
