<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The suit as an Exosuit Framework core frame. Like every framework module it is a pair:
       the item (crafted, carried, installed in bays) and the apparel the pilot wears. -->
  <ThingDef ParentName="ModuleItemBase">
    <defName>RPS_PowerSuitCoreItem</defName>
    <label>power suit</label>
    <description>A hulking powered exoskeleton built around a round diving-style helmet. Stand it up anywhere with "Set up power suit here" and a colonist can climb inside to work and fight in it, then climb out and leave it standing. Install it at a maintenance bay to fit modules and have it repaired.\n\nA pilot can wield the heavy weapons built for warcaskets.</description>
    <graphicData>
      <texPath>Things/Item/PowerSuit/PowerSuitFrame</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <Mass>85</Mass>
      <WorkToMake>60000</WorkToMake>
    </statBases>
    <costList>
      <Plasteel>120</Plasteel>
      <Steel>200</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>RPS_PowerSuits</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>RPS_PowerSuitCore</EquipedThingDef>
        <occupiedSlots>
          <li>Core</li>
        </occupiedSlots>
      </li>
    </comps>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li><weight>10</weight><only>(0.58,0.60,0.42)</only></li>
        <li><weight>6</weight><only>(0.56,0.58,0.60)</only></li>
        <li><weight>4</weight><only>(0.78,0.68,0.50)</only></li>
        <li><weight>2</weight><only>(0.66,0.40,0.32)</only></li>
      </options>
    </colorGenerator>
    <modExtensions>
      <li Class="RimoutPowerSuit.ExosuitBridge.DeployableCoreExtension" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ModuleApparelBase">
    <defName>RPS_PowerSuitCore</defName>
    <label>power suit</label>
    <description>A hulking powered exoskeleton built around a round diving-style helmet.</description>
    <thingClass>RimoutPowerSuit.ExosuitBridge.PowerSuitCore</thingClass>
    <graphicData>
      <texPath>Things/Item/PowerSuit/PowerSuitFrame</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <ArmorRating_Sharp>1.0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
      <ArmorRating_Heat>0.6</ArmorRating_Heat>
      <Insulation_Cold>25</Insulation_Cold>
      <Insulation_Heat>10</Insulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.6</MoveSpeed>
      <CarryingCapacity>75</CarryingCapacity>
      <MeleeDamageFactor>0.3</MeleeDamageFactor>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>ExosuitLayer_Core</li>
      </layers>
      <wornGraphicPath>Things/Pawn/PowerSuit/PowerSuitFrame</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <renderSkipFlags>
        <li>Head</li>
        <li>Hair</li>
        <li>Beard</li>
        <li>Eyes</li>
        <li>Tattoos</li>
      </renderSkipFlags>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
    <!-- Lets VFE Pirates' warcasket weapons accept the pilot (VEF's heavy-weapon check). -->
    <tradeTags Inherit="False">
      <li>Warcasket</li>
    </tradeTags>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>RPS_PowerSuitCoreItem</ItemDef>
        <occupiedSlots>
          <li>Core</li>
        </occupiedSlots>
      </li>
    </comps>
    <modExtensions>
      <li Class="Exosuit.ExosuitExt">
        <RequireAdult>true</RequireAdult>
      </li>
      <li Class="VEF.Apparels.ApparelExtension">
        <isUnifiedApparel>true</isUnifiedApparel>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Where a suit stands while nobody is in it: a one-tile bay with no equipment, made when
       a pilot climbs out or a suit is set up, gone once someone climbs in. -->
  <ThingDef ParentName="MaintanenceBayBase">
    <defName>RPS_SuitStand</defName>
    <label>power suit</label>
    <description>A power suit standing empty, ready for a pilot to climb in.</description>
    <thingClass>RimoutPowerSuit.ExosuitBridge.Building_SuitStand</thingClass>
    <graphicData>
      <texPath>Things/Building/PowerSuit/SuitStand</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <designationCategory IsNull="True" />
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <useHitPoints>false</useHitPoints>
    <stealable>false</stealable>
    <blockLight>false</blockLight>
    <blockWind>false</blockWind>
    <statBases>
      <WorkToBuild>0</WorkToBuild>
      <WorkTableWorkSpeedFactor>1</WorkTableWorkSpeedFactor>
    </statBases>
    <modExtensions>
      <li Class="Exosuit.BayExtension" />
    </modExtensions>
  </ThingDef>

</Defs>
